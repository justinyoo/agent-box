{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "scriptPayloadPart1": { "value": "${VM_SCRIPT_PAYLOAD_1}" },
    "scriptPayloadPart2": { "value": "${VM_SCRIPT_PAYLOAD_2}" },
    "scriptPayloadPart3": { "value": "${VM_SCRIPT_PAYLOAD_3}" },
    "adminUsername": { "value": "${VM_ADMIN_USERNAME}" },
    "adminPassword": { "value": "${VM_ADMIN_PASSWORD}" },
    "maiFoundryRegion": { "value": "${MAI_FOUNDRY_REGION}" },
    "maiImageCapacity": { "value": "${MAI_IMAGE_CAPACITY}" },
    "maiImageDeploymentName": { "value": "${MAI_IMAGE_DEPLOYMENT_NAME_OVERRIDE}" },
    "maiVoiceModel": { "value": "${MAI_VOICE_MODEL_OVERRIDE}" },
    "maiTranscribeModel": { "value": "${MAI_TRANSCRIBE_MODEL_OVERRIDE}" },
    "vmName": { "value": "${VM_NAME_OVERRIDE}" },
    "computerName": { "value": "${VM_COMPUTER_NAME_OVERRIDE}" },
    "vmSize": { "value": "${VM_SIZE}" },
    "zone": { "value": "${VM_ZONE}" },
    "imagePublisher": { "value": "${VM_IMAGE_PUBLISHER}" },
    "imageOffer": { "value": "${VM_IMAGE_OFFER}" },
    "imageSku": { "value": "${VM_IMAGE_SKU}" },
    "imageVersion": { "value": "${VM_IMAGE_VERSION}" },
    "osDiskSizeGb": { "value": "${VM_OS_DISK_SIZE_GB}" },
    "osDiskType": { "value": "${VM_OS_DISK_TYPE}" },
    "diskControllerType": { "value": "${VM_DISK_CONTROLLER}" },
    "acceleratedNetworking": { "value": "${VM_ACCELERATED_NETWORKING}" },
    "vnetAddressPrefix": { "value": "${VM_VNET_PREFIX}" },
    "subnetAddressPrefix": { "value": "${VM_SUBNET_PREFIX}" },
    "autoShutdownEnabled": { "value": "${VM_AUTO_SHUTDOWN_ENABLED}" },
    "tags": { "value": "${VM_TAGS}" }
  }
}
